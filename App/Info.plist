<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Gold Rush</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- Declares the app uses no non-exempt encryption, so TestFlight stops
	     asking the export-compliance question on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The AdMob app ID, not the ad unit ID. The SDK deliberately traps on
	     launch if this key is missing or malformed, rather than failing
	     quietly at the first ad request. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3388571830343061~3849777872</string>
	<!-- Google's own SKAdNetwork identifier, so ad installs can be attributed
	     without asking the user for tracking permission. Google publishes a
	     longer list covering the other networks that can bid; adding those is
	     a revenue optimisation rather than a requirement, and is deliberately
	     left out here rather than transcribed from a page by hand. See
	     docs/DEPLOYMENT.md. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
